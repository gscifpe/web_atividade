<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listar Pessoas</title>
</head>
<body>
    <a href="/pessoas/cadastrar">Cadastrar Pessoa</a>
    <h1>{{pessoa.nome}}</h1>

<label>Passaporte:</label>
{{#if pessoa.passaporte}}
  <ul>
    <li>Número: {{pessoa.passaporte.numero}}</li>
    <li>Validade: {{pessoa.passaporte.validade}}</li>
  </ul>
{{else}}
  <a href="/pessoas/{{pessoa.id}}/passaporte/cadastrar">Cadastrar passaporte</a>
{{/if}}
</body>
</html>