<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Passaporte</title>
</head>
<body>
    <h1>Cadastrar Passaporte</h1>

<p>Pessoa: {{pessoa.nome}}</p>

<form action="/pessoas/{{pessoa.id}}/passaporte/cadastrar" method="POST">

    <label>Número do Passaporte:</label>
    <input type="text" name="numero" required>

    <br><br>

    <label>Validade:</label>
    <input type="date" name="validade" required>

    <br><br>

    <button type="submit">
        Cadastrar Passaporte
    </button>

</form>
</body>
</html>